# Optional: enables live AIS data. Never commit the real value.
AISSTREAM_API_KEY=

# Optional: enables GFW identity, event history, fishing effort, and SAR layers.
GFW_API_TOKEN=

# Optional: local Protected Planet marine WDPA/WDOECM CSV used to name
# protected areas referenced by GFW events. The CSV package has attributes,
# not boundary geometry.
AEGIS_WDPA_CSV=

# Optional: adds Copernicus surface currents to dark-contact predictions.
COPERNICUS_MARINE_USERNAME=
COPERNICUS_MARINE_PASSWORD=

# Optional runtime settings.
AEGIS_PACK=s02_synthetic_demo
AEGIS_FRAMES=-1
AEGIS_LLM=mockllm
AEGIS_MAX_ACTIVE_VESSELS=100000
AEGIS_AIS_STATE_PATH=.aegis/ais_state.json.gz
PORT=8765
